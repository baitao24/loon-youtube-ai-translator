#!name = YouTube AI 双语字幕
#!desc = 用 AI 把 YouTube 字幕翻成双语，支持 Gemini、DeepSeek、OpenAI、Claude。开字幕后约 6 秒内尽量多翻，没翻到的行先显示原文；关掉再打开字幕会接着翻。只需填写所选模型那一家的 API Key。
#!author = aot & Claude
#!homepage = https://github.com/baitao24/loon-youtube-ai-translator
#!tag = YouTube,字幕,AI,翻译
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.4.0(962)
#!version = 0.6.0

[Argument]
ai_enabled = switch,true,tag=AI 翻译,desc=关闭后不做翻译，只显示 YouTube 原文字幕
model = select,"gemini-3.5-flash-lite","gemini-3.1-flash-lite","gemini-flash-lite-latest","gemini-2.5-flash-lite","gemini-3.5-flash","gemini-3.8-flash","deepseek-flash","deepseek-v4-pro","gpt-5.4-nano","gpt-5.4-mini","claude-haiku-4-5","claude-sonnet-5-5",tag=模型,desc=服务商按模型名自动判断，只需填对应那家的 Key。默认的 Gemini 3.5 Flash-Lite 真机实测最快；带 lite、nano、haiku、deepseek-flash 的都是快速模型，其他模型更细致但更慢，长视频第一次能翻到的部分会少一些。每批条数会按实测速度自动调整
api_key = input,"",tag=Gemini API Key,desc=选 gemini 开头的模型时填写；在 Google AI Studio 创建
deepseek_api_key = input,"",tag=DeepSeek API Key,desc=选 deepseek 开头的模型时填写；在 platform.deepseek.com 创建
openai_api_key = input,"",tag=OpenAI API Key,desc=选 gpt 开头的模型时填写；在 platform.openai.com 创建
claude_api_key = input,"",tag=Claude API Key,desc=选 claude 开头的模型时填写；在 platform.claude.com 创建
target_language = select,"简体中文","繁體中文","日本語","한국어","English",tag=翻译成,desc=如果在 YouTube 字幕菜单里选了「自动翻译」成某种语言，以菜单为准
Position = select,"原文在上","译文在上",tag=字幕顺序,desc=每种语言各占一行
ShowOnly = switch,false,tag=只显示译文,desc=开启后不显示原文
custom_prompt = input,"",tag=额外翻译要求,desc=例如：人名保留英文；科技术语按业内习惯翻译。不要在这里填写密钥
LogLevel = select,"INFO","DEBUG","WARN","ERROR","OFF",tag=日志等级,desc=排查问题时看 Loon 脚本日志；日志不记录 API Key 和字幕全文

[Script]
# 只拦截字幕接口（/api/timedtext），不碰 player、get_watch 等播放信息接口，
# 避免和 YouTube 去广告插件处理同一个请求导致去广告失效
# AI 翻译：请求阶段去掉 tlang（YouTube 对它返回 429），响应阶段直接翻原文字幕
http-request ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$ script-path=https://raw.githubusercontent.com/baitao24/loon-youtube-ai-translator/main/dist/dualsubs-ai.bundle.js, timeout=8, tag=AI 字幕请求, argument=[{ai_enabled},{model},{api_key},{deepseek_api_key},{openai_api_key},{claude_api_key},{target_language},{Position},{ShowOnly},{custom_prompt},{LogLevel}]
# Loon 按改写前的地址匹配响应规则，所以这里匹配原始 timedtext 地址；脚本内部再检查 dsai 标记
http-response ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$ requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/baitao24/loon-youtube-ai-translator/main/dist/dualsubs-ai.bundle.js, timeout=8, tag=AI 字幕响应, argument=[{ai_enabled},{model},{api_key},{deepseek_api_key},{openai_api_key},{claude_api_key},{target_language},{Position},{ShowOnly},{custom_prompt},{LogLevel}]

[MITM]
hostname = www.youtube.com, m.youtube.com
